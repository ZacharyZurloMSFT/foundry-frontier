      "site_address": {"type": "string"},
      "requested_service": {"type": "string"},
      "requested_date": {"type": "date"},
      "priority": {"type": "string", "enum": ["P1","P2","P3","P4"]},
      "contact_email": {"type": "string"},
      "contact_phone": {"type": "string"}
    }
  }
