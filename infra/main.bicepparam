using './main.bicep'

// azd prefers this file and passes its environment to the Bicep compiler.
// Compiler serialization preserves JSON-valued strings without raw interpolation.
param environmentName = readEnvironmentVariable('AZURE_ENV_NAME')
param location = readEnvironmentVariable('AZURE_LOCATION', 'canadacentral')
param aiLocation = readEnvironmentVariable('AZURE_AI_LOCATION', 'eastus2')
// Canonical names first; the deprecated ORDER_* / ORDERS_* names are still read so existing azd environments keep working.
param insuranceProjectName = readEnvironmentVariable('INSURANCE_PROJECT_NAME', readEnvironmentVariable('ORDER_PROJECT_NAME', 'northwind-orders'))
param hostedAgentsEnabled = readEnvironmentVariable('HOSTED_AGENTS_ENABLED', readEnvironmentVariable('ORDER_AGENTS_HOSTED', 'true'))
param reuseExistingResources = readEnvironmentVariable('NORTHWIND_REUSE_EXISTING_RESOURCES', 'false')
param appsResourceGroupName = readEnvironmentVariable('AZURE_APPS_RESOURCE_GROUP', '')
param dataResourceGroupName = readEnvironmentVariable('AZURE_DATA_RESOURCE_GROUP', '')
param networkingResourceGroupName = readEnvironmentVariable('AZURE_NETWORKING_RESOURCE_GROUP', '')
param aiResourceGroupName = readEnvironmentVariable('AZURE_AI_RESOURCE_GROUP', '')
param foundryResourceGroupName = readEnvironmentVariable('AZURE_FOUNDRY_RESOURCE_GROUP', '')
param observabilityResourceGroupName = readEnvironmentVariable('AZURE_OBSERVABILITY_RESOURCE_GROUP', '')
param logAnalyticsResourceGroupName = readEnvironmentVariable('AZURE_LOG_ANALYTICS_RESOURCE_GROUP', '')
param legacyResourceGroupName = readEnvironmentVariable('AZURE_LEGACY_RESOURCE_GROUP', '')
param containerAppsEnvironmentResourceGroupName = readEnvironmentVariable('AZURE_CONTAINER_APPS_ENVIRONMENT_RESOURCE_GROUP', '')
param vnetResourceGroupName = readEnvironmentVariable('AZURE_VNET_RESOURCE_GROUP', '')
param cosmosPrivateEndpointName = readEnvironmentVariable('AZURE_COSMOS_PRIVATE_ENDPOINT_NAME', 'pe-zz-cosmos-northwind')
param insuranceAgentsReady = readEnvironmentVariable('NORTHWIND_INSURANCE_AGENTS_READY', 'false')
param insuranceOrchestratorAgentId = readEnvironmentVariable('FOUNDRY_INSURANCE_ORCHESTRATOR_AGENT_ID', '')
param businessApiEnabled = readEnvironmentVariable('NORTHWIND_BUSINESS_API_ENABLED', 'false')
param insuranceAuthTenantId = readEnvironmentVariable('INSURANCE_AUTH_TENANT_ID', '')
param insuranceAuthAudience = readEnvironmentVariable('INSURANCE_AUTH_AUDIENCE', '')
param insuranceAuthRequiredScope = readEnvironmentVariable('INSURANCE_AUTH_REQUIRED_SCOPE', 'access_as_user')
param insuranceAuthClientIds = readEnvironmentVariable('INSURANCE_AUTH_CLIENT_IDS', '')
param gatewayUrl = readEnvironmentVariable('NORTHWIND_GATEWAY_URL', '')
param gatewayStack = readEnvironmentVariable('NORTHWIND_GATEWAY_STACK', 'insurance')
param existingSettings = {
  FOUNDRY_ENDPOINT: readEnvironmentVariable('FOUNDRY_ENDPOINT', '')
  FOUNDRY_PROJECT_ENDPOINT: readEnvironmentVariable('FOUNDRY_PROJECT_ENDPOINT', '')
  AZURE_AI_PROJECT_ENDPOINT: readEnvironmentVariable('AZURE_AI_PROJECT_ENDPOINT', '')
  FOUNDRY_PROJECT_ENDPOINTS: readEnvironmentVariable('FOUNDRY_PROJECT_ENDPOINTS', '')
  AGENT_OPENAI_ENDPOINT: readEnvironmentVariable('AGENT_OPENAI_ENDPOINT', readEnvironmentVariable('ORDERS_OPENAI_ENDPOINT', ''))
  AZURE_OPENAI_ENDPOINT: readEnvironmentVariable('AZURE_OPENAI_ENDPOINT', '')
  AGENT_KB_CONNECTION_NAME: readEnvironmentVariable('AGENT_KB_CONNECTION_NAME', readEnvironmentVariable('ORDERS_KB_CONNECTION_NAME', ''))
  FOUNDRY_KB_CONNECTION_NAME: readEnvironmentVariable('FOUNDRY_KB_CONNECTION_NAME', '')
  FOUNDRY_PLANNER_DEPLOYMENT: readEnvironmentVariable('FOUNDRY_PLANNER_DEPLOYMENT', '')
  FOUNDRY_WORKER_DEPLOYMENT: readEnvironmentVariable('FOUNDRY_WORKER_DEPLOYMENT', '')
  FOUNDRY_PROMPT_AGENT_DEPLOYMENT: readEnvironmentVariable('FOUNDRY_PROMPT_AGENT_DEPLOYMENT', '')
  FOUNDRY_EMBEDDING_DEPLOYMENT: readEnvironmentVariable('FOUNDRY_EMBEDDING_DEPLOYMENT', '')
  AZURE_AI_MODEL_DEPLOYMENT_NAME: readEnvironmentVariable('AZURE_AI_MODEL_DEPLOYMENT_NAME', '')
  COSMOS_DATABASE: readEnvironmentVariable('COSMOS_DATABASE', '')
  STORAGE_CU_CONTAINER: readEnvironmentVariable('STORAGE_CU_CONTAINER', '')
  STORAGE_SEED_CONTAINER: readEnvironmentVariable('STORAGE_SEED_CONTAINER', '')
}
param principalId = readEnvironmentVariable('AZURE_PRINCIPAL_ID', '')
param harnessEnabled = readEnvironmentVariable('COPILOT_HARNESS_ENABLED', 'false')
